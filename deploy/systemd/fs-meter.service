[Unit]
Description=Radioactive Foot Pi fs-meter kernel monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/default/fs-meter
Environment=APP_ROOT=/opt/radioactive-foot-pi
Environment=SETTINGS_FILE=/opt/radioactive-foot-pi/common/fs_meter_settings.json
WorkingDirectory=/opt/radioactive-foot-pi
ExecStart=/bin/sh -c '/usr/bin/python3 "${APP_ROOT}/common/fs_meter_kernel_filtered.py" --settings-file "${SETTINGS_FILE}"'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
